<!-- <div class="container lobby-container"> -->
<div class="container lobby-container">
  <div class="row">
    <div class="col-xs-6 col-sm-9" id="col1">
      <div style="position: relative">
        <strong>
          <span id="all-chat-lobby-text"> All Chat </span>
        </strong>

        <div
          react-entrypoint
          id="reportDiv"
          style="
            float: right;
            position: absolute;
            right: 0;
            transform: translate(0, -100%);
          "
        >
          <%-reportsReact%>
        </div>
      </div>

      <div class="chat-window" id="all-chat-lobby">
        <ol class="chat-list all-chat-list" id="all-chat-lobby-list"></ol>
      </div>
      <p id="all-chat-lobby-bar" class="hidden chat-bar"></p>

      <input type="text" class="chat-message-input all-chat-message-input" />
    </div>

    <div class="col-xs-6 col-sm-3" id="col2">
      <!-- <br> -->
      <strong>
        <p>Games (<span class="games-count">0</span>):</p>
      </strong>

      <a id="newRoom" class="btn btn-default" href="#">New Room</a>

      <br />
      <br />

      <div react-entrypoint id="matchmakingDiv"><%-matchmakingReact%></div>

      <br />
      <br />

      <table
        id="current-games-table"
        class="table table-bordered table-striped lobby-table"
      >
        <tbody></tbody>
      </table>

      <br />
      <p>
        <strong>Online players (<span class="player-count"></span>):</strong>
      </p>

      <table
        id="current-players-table"
        class="table table-bordered table-striped lobby-table"
      >
        <tbody></tbody>
      </table>
    </div>
  </div>
</div>

<%- include('partials/gameRoom') %>

<!-- Modal for game options-->
<div id="roleOptionsModal" class="modal fade" role="dialog">
  <div class="modal-dialog">
    <!-- Modal content-->
    <div class="modal-content">
      <div class="modal-header">
        <button type="button" class="close" data-dismiss="modal">
          &times;
        </button>
        <h2 class="modal-title">Game options!</h2>
      </div>
      <div class="modal-body">
        <h4>Select the roles/items you would like in the game.</h4>
        <h6>Default roles have been pre-selected.</h6>

        <label>Game Mode:</label>
        <select class="gameModeSelect" name="gameMode">
          <!-- The usual values look like the below. This part is inserted dynamically in lobby.js -->
          <!-- <option value="avalon">Avalon</option> -->
          <!-- <option value="hunter">Hunter</option> -->
          <!-- <option value="original">Original</option> -->
        </select>
        <br />

        <div class="avalonSelectCheck" style="display: block">
          <label>Type:</label>
          <select class="rankedSelect" name="ranked">
            <option value="ranked">Ranked (Beta)</option>
            <option value="unranked">Unranked</option>
          </select>
        </div>

        <label>Default Timeout: min: <input type="text" id="startGameOptionsDefaultPhaseTimeoutMin" style="width: 3em;" value="1" min="0" max="99"></label>
        <label>sec: <input type="text" id="startGameOptionsDefaultPhaseTimeoutSec" style="width: 3em;" value="30" min="0" max="60"></label>
        <br>
        <label>Critical Mission Timeout: min:  <input type="number" id="startGameOptionsCritMissionTimeoutMin" style="width: 3em;" value="3" min="0" max="99"></label>
        <label>sec:  <input type="text" id="startGameOptionsCritMissionTimeoutSec" style="width: 3em;" value="0" min="0" max="60"></label>
        <br>
        <label>Assassination Timeout: min:  <input type="number" id="startGameOptionsAssassinationPhaseTimeoutMin" style="width: 3em;" value="11" min="0" max="99"></label>
        <label>sec:  <input type="text" id="startGameOptionsAssassinationPhaseTimeoutSec" style="width: 3em;" value="0" min="0" max="60"></label>
        <br>
        <label>Anonymous mode:</label>
        <input type="checkbox" name="startGameOptionsAnonymousMode" id="startGameOptionsAnonymousMode"/>

        <div class="row">
          <div
            class="btn-group-vertical col-sm-4 col-xs-12"
            data-toggle="buttons"
            id="rolesCardsButtonGroup"
          ></div>

          <div
            class="btn-group-vertical col-sm-8 col-xs-12"
            data-toggle="buttons"
            id="rolesCardsButtonGroupDescription"
          ></div>
        </div>

        <br />

        <label>Max number of players:</label>
        <select class="maxNumPlayers" name="maxNumPlayers">
          <option value="5">5</option>
          <option value="6">6</option>
          <option value="7">7</option>
          <option value="8">8</option>
          <option value="9">9</option>
          <option value="10" selected="selected">10</option>
        </select>

        <br />

        <label>Mute spectators for table:</label>
        <input type="checkbox" name="muteSpectators" class="muteSpectators" />
        <br />
        <label>Disable Vote History:</label>
        <input type="checkbox" name="disableVoteHistory" class="disableVoteHistory"/>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-default" data-dismiss="modal">
          Close
        </button>
      </div>
    </div>
  </div>
</div>

<!-- Modal for kicking players-->
<div id="kickModal" class="modal fade" role="dialog">
  <div class="modal-dialog">
    <!-- Modal content-->
    <div class="modal-content">
      <div class="modal-header">
        <button type="button" class="close" data-dismiss="modal">
          &times;
        </button>
        <h2 class="modal-title">Kick players</h2>
      </div>
      <div class="modal-body" id="kickModalContent"></div>
      <div class="modal-footer">
        <button
          type="button"
          class="btn btn-danger"
          data-dismiss="modal"
          id="kickButton"
        >
          Kick
        </button>
        <button type="button" class="btn btn-default" data-dismiss="modal">
          Close
        </button>
      </div>
    </div>
  </div>
</div>

<!-- Modal for Moderators-->
<div id="modModal" class="modal fade" role="dialog">
  <div class="modal-dialog">
    <!-- Modal content-->
    <div class="modal-content">
      <div class="modal-header">
        <button type="button" class="close" data-dismiss="modal">
          &times;
        </button>
        <h2 class="modal-title" style="color: red; font-weight: 700">
          Ban menu
        </h2>
      </div>

      <div style="width: 75%; margin: auto">
        <br />
        <form action="/mod/ban" method="POST" id="modactionform">
          <div class="form-group">
            <label for="banPlayerUsername">Username of player to ban: </label>
            <input
              name="banPlayerUsername"
              type="text"
              class="form-control"
              id="banPlayerUsername"
              placeholder="Username"
              required
            />
          </div>

          <div class="form-group">
            <h3 style="font-weight: 700; display: inline">Type of ban:</h3>
            <h6 style="display: inline">
              Note: If IP ban is selected, all IPs the user has ever logged onto
              will be banned for the specified duration.
            </h6>
            <br />
            <label
              ><input type="checkbox" name="userBanCheckbox" /> User ban</label
            >
            <!--! fill in the id/data-->
            <br />
            <label
              ><input type="checkbox" name="IPBanCheckbox" /> Full IP ban</label
            >
            <br />
            <label
              ><input type="checkbox" name="SingleIPBanCheckbox" /> Last IP ban
              (Single)</label
            >
          </div>

          <div class="form-group">
            <label for="reason">Reason: </label>
            <br />
            <select
              name="reason"
              class="form-control"
              id="typeofmodaction"
              required
            >
              <option value="">Please select an option</option>
              <option value="abusive">Abusive</option>
              <option value="griefing">Intentional throwing/griefing</option>
              <option value="afk">Inactivity (AFK)</option>
              <option value="spam">Spam</option>
              <option value="cheating">
                Cheating (multiaccounting or talking outside of game)
              </option>
              <option value="other">Other</option>
            </select>
          </div>

          <div class="form-group">
            <h3 style="font-weight: 700; display: inline">Duration:</h3>
            <h6 style="display: inline">
              Note: If perma ban is selected, the number given is not used.
            </h6>
            <div class="input-group">
              <input
                type="text"
                class=""
                id="duration"
                name="duration"
                placeholder="<number>"
                required
              />
              <select
                name="duration_units"
                class=""
                id="durationofmodaction"
                required
              >
                <option value="">None</option>
                <option value="hrs">hrs</option>
                <option value="days">days</option>
                <option value="months">months</option>
                <option value="years">years</option>
                <option value="permaban">permaban</option>
              </select>
            </div>
          </div>

          <div class="form-group">
            <label for="descriptionByMod"
              >Description:
              <h6 style="display: inline">
                The user being banned will see this message. This message will
                also appear in the moderator logs.
              </h6></label
            >
            <br />
            <textarea
              name="descriptionByMod"
              class="form-control"
              style="width: 100%"
              id="descriptionByMod"
              required
            ></textarea>
          </div>

          <!--<input type="submit" value="Slam the hammer of judgement!" class="btn btn-danger" id="modActionCloseButton">-->
          <button
            id="modActionCloseButton"
            type="button"
            class="btn btn-danger"
          >
            Submit
          </button>
          <br />
          <br />
        </form>
      </div>

      <div class="modal-footer">
        <button type="button" class="btn btn-default" data-dismiss="modal">
          Close
        </button>
      </div>
    </div>
  </div>
</div>

<!-- newRoomModal -->
<div id="newRoomModal" class="modal fade" role="dialog">
  <div class="modal-dialog">
    <!-- Modal content-->
    <div class="modal-content">
      <div class="modal-header">
        <button type="button" class="close" data-dismiss="modal">
          &times;
        </button>
        <h2 class="modal-title">New Room options!</h2>
      </div>
      <div class="modal-body">
        <h4>Select your room options!</h4>
        <h6>Default settings have been pre-selected.</h6>

        <label>Game mode:</label>
        <select class="gameModeSelect" name="gameMode">
          <!-- The usual values look like the below. This part is inserted dynamically in lobby.js -->
          <!-- <option value="avalon">Avalon</option> -->
          <!-- <option value="hunter">Hunter</option> -->
          <!-- <option value="original">Original</option> -->
        </select>
        <br />

        <div class="avalonSelectCheck" style="display: block">
          <label>Type:</label>
          <select class="rankedSelect" name="ranked">
            <option value="ranked">Ranked (Beta)</option>
            <option value="unranked">Unranked</option>
          </select>
        </div>

        <label>Max number of players:</label>
        <select class="maxNumPlayers soflow" name="maxNumPlayers">
          <option value="5">5</option>
          <option value="6">6</option>
          <option value="7">7</option>
          <option value="8">8</option>
          <option value="9">9</option>
          <option value="10" selected="selected">10</option>
        </select>
        <br />
        <label
          >Password:
          <input
            type="text"
            name="newRoomPassword"
            id="newRoomPassword"
            autocapitalize="off"
            autocomplete="off"
            autocorrect="off"
            placeholder="(Optional)"
            style=""
        /></label>

        <br />

        <label>Mute spectators for table:</label>
        <input type="checkbox" name="muteSpectators" class="muteSpectators" />
        <br/>
        <label>Close Vote History:</label>
        <input type="checkbox" name="disableVoteHistory" class="disableVoteHistory" />
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-danger" data-dismiss="modal">
          Close
        </button>

        <button
          id="createNewRoomButton"
          type="button"
          class="btn btn-success"
