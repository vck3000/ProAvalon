<%- include('partials/header') %>

<script>
  // The lobby scripts and the gameRoom partial reference images by RELATIVE
  // path ('avatars/base-res.svg', 'pictures/gun.png'). From /lobby those
  // resolve to the asset root; from /replay/:id they'd resolve to
  // /replay/avatars/... and 404. A <base href="/"> restores lobby-identical
  // resolution. Injected into <head> synchronously, before the room partial
  // parses, so it covers both static and runtime-generated images. All
  // hrefs/srcs in the shared partials are absolute (audited), so the base
  // affects only these image paths.
  document.head.appendChild(
    Object.assign(document.createElement('base'), { href: '/' })
  );
</script>

<script>
  // ---------------------------------------------------------------------
  // Replay mode: no socket.io connection. lobby.js declares
  // `const socket = io();` at its top — so the shim replaces io(), handing
  // lobby.js a fake socket. Every `socket.on(...)` registration in the
  // lobby scripts lands here; the replay driver fires them locally via
  // trigger(). Outbound emits are swallowed.
  // ---------------------------------------------------------------------
  var __replayFakeSocket = {
    _h: {},
    on: function (ev, fn) {
      (this._h[ev] = this._h[ev] || []).push(fn);
    },
    emit: function () {
      /* replay mode: swallow outbound traffic */
    },
    trigger: function (ev, data) {
      var fns = this._h[ev] || [];
      for (var i = 0; i < fns.length; i++) {
        fns[i](data);
      }
    },
  };
  function io() {
    return __replayFakeSocket;
  }
  var IS_REPLAY_MODE = true;
  // Globals normally defined in sockets.js (not loaded in replay mode) that
  // the loaded lobby scripts reference: spectator list, mute list, online
  // players. Empty is correct for replays.
  var oldSpectators = [];
  var mutedPlayers = [];
  var currentOnlinePlayers = [];
</script>

